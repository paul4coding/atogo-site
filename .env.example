# =============================================================================
#  @TOGO — Variables d'environnement
#  Dev    : cp .env.example .env.local
#  Docker : cp .env.example .env
#  Ne JAMAIS commiter .env / .env.local (ils sont dans .gitignore).
# =============================================================================

# --- Base de données PostgreSQL (obligatoire) --------------------------------
# Dev local (Postgres installé sur la machine) :
DATABASE_URL=postgresql://atogo:motdepasse@localhost:5432/atogo
# Avec docker compose, le service s'appelle « db » :
# DATABASE_URL=postgresql://atogo:motdepasse@db:5432/atogo

# Postgres managé exigeant du TLS (Neon, RDS, Scaleway…) : passer à true
DATABASE_SSL=false
# Taille max du pool de connexions (défaut 10)
# DATABASE_POOL_MAX=10

# Utilisées uniquement par docker compose pour initialiser le conteneur postgres
POSTGRES_USER=atogo
POSTGRES_PASSWORD=motdepasse
POSTGRES_DB=atogo

# --- Session admin (obligatoire) ---------------------------------------------
# Clé de signature des JWT de session. 32 caractères MINIMUM.
# Générer avec :  openssl rand -base64 48
SESSION_SECRET=remplacer-par-une-cle-aleatoire-de-48-caracteres-minimum
# Durée de vie d'une session en secondes (défaut 43200 = 12 h)
# SESSION_MAX_AGE=43200

# --- Stockage des fichiers (obligatoire) -------------------------------------
# Dossier où sont écrits CV, lettres, dossiers .zip et images d'actualités.
# DOIT être un volume persistant — voir DEPLOY.md.
#   dev    : ./storage
#   docker : /app/storage (monté sur le volume « atogo-storage »)
STORAGE_DIR=./storage

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxx

# --- URL du site -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
